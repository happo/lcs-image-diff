{
  "name": "lcs-image-diff",
  "version": "4.5.0",
  "description": "A JavaScript library to diff two images. Uses the Longest-Common-Subsequence algorithm to allow content to shift.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./computeAndInjectDiffs.js": {
      "types": "./dist/computeAndInjectDiffs.d.ts",
      "default": "./dist/computeAndInjectDiffs.js"
    },
    "./colorDelta.js": {
      "types": "./dist/colorDelta.d.ts",
      "default": "./dist/colorDelta.js"
    },
    "./alignmentReplay.js": {
      "types": "./dist/alignmentReplay.d.ts",
      "default": "./dist/alignmentReplay.js"
    },
    "./antialiasing.js": {
      "types": "./dist/antialiasing.d.ts",
      "default": "./dist/antialiasing.js"
    },
    "./src/computeAndInjectDiffs.js": {
      "types": "./dist/computeAndInjectDiffs.d.ts",
      "default": "./dist/computeAndInjectDiffs.js"
    },
    "./src/colorDelta.js": {
      "types": "./dist/colorDelta.d.ts",
      "default": "./dist/colorDelta.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "authors": [
    "Henric Persson <henric@happo.io>",
    "Joe Lencioni <joe@happo.io>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/happo/lcs-image-diff.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke": "tsc -p tsconfig.smoke.json && node scripts/smoke.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "tsc": "tsc",
    "lint": "eslint .",
    "release": "set -a && source .env && set +a && release-with-ease",
    "serve": "node server.ts",
    "profile": "node profile.ts"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 80,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "jiti": "^2.7.0",
    "release-with-ease": "^2.8.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
